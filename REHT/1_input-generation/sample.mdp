title			= REHT NVT w/ a14SBff
; Run parameters
define			= 	; 
integrator		= md		; leap-frog integrator
nsteps			= 500000	; 1 ns
dt		    	= 0.002		; 2 fs

; Output control
nstxout		        = 0		; save coordinates every 10.0 ps
nstvout		        = 10000		; save velocities every 10.0 ps
nstenergy	        = 1000		; save energies every 10.0 ps
nstlog		        = 1000		; update log file every 10.0 ps
nstxout-compressed  	= 5000         ; save compressed coordinates every 10.0 ps
;compressed-x-grps   	= non-Water   ; write non-Water coordinates, replaces xtc-grps
;xtc-precision           = 1000       ; precision for output file
;energygrps			 = Protein Water_and_ions   

; Bond parameters
continuation	        = no		; Restarting after NPT 
constraint_algorithm    = lincs	    ; holonomic constraints 
constraints	            = all-bonds	; all bonds (even heavy atom-H bonds) constrained
lincs_iter	            = 1		    ; accuracy of LINCS
lincs_order	            = 4		    ; also related to accuracy

; Neighborsearching
cutoff-scheme   	= Verlet
ns_type		        = grid		; search neighboring grid cells
pbc                 = xyz               ; type of pbc

; electrostatic
rcoulomb            = 1.0               ; short-range electrostatic cutoff (in nm)
coulombtype         = pme               ; electrostatic type
pme_order	    	= 4		; cubic interpolation
fourierspacing      = 0.16              ; fourier grid spacing

; vdw
rvdw                = 1.0              ; short-range van der Waals cutoff (in nm)
DispCorr		= EnerPres	            ; account for cut-off vdW scheme

; Temperature coupling is on
tcoupl		= V-rescale	            ; modified Berendsen thermostat
tc-grps		= Protein Water_and_ions   
tau_t		= 0.1     0.1         	; time constant, in ps
ref_t		= XXX 	  XXX	        ; reference temperature, one for each group, in K

; Pressure coupling is off
pcoupl		= no 		; no pressure coupling in NVT

; Velocity generation
gen_vel		= yes		; assign velocities from Maxwell distribution
gen_temp	= XXX		; temperature for Maxwell distribution
gen_seed	= -1		; generate a random seed

